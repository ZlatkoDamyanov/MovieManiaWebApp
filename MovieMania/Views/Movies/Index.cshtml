@using Data
@model List<Movie>

<style>
    body {
        background-color: #0e0e0e;
        color: white;
    }

    .search-box input {
        background-color: #1c1c1c;
        border: none;
        color: white;
    }

    .search-box input::placeholder {
        color: #aaa;
    }

    .movie-card {
        background-color: #1a1a1a;
        border: none;
        border-radius: 10px;
        overflow: hidden;
        transition: transform 0.2s;
    }

    .movie-card:hover {
        transform: scale(1.03);
    }

    .movie-img {
        height: 300px;
        object-fit: cover;
    }

    .rating {
        color: gold;
        font-weight: bold;
    }

    .footer-btns a {
        margin: 3px;
    }
</style>

<!-- Search -->
<div class="d-flex justify-content-center align-items-center mb-4" style="height: 100px;">
    <form method="get" class="w-50">
        <input name="search" class="form-control form-control-lg" placeholder="🔍 Търсене на филми, сериали..." />
    </form>
</div> 

<!-- HEADER -->
<div class="d-flex justify-content-between align-items-center mb-4">

    <h2 class="mb-0">🎬 Movie Catalog</h2>

    <a asp-action="Create" class="footer-btn btn-success btn-lg">
        + Add Movie
    </a>
</div>

    <!-- GRID -->
    <div class=" container">
        <div class="row">

            @foreach (var movie in Model)
            {
                <div class="col-md-4 mb-4">
                    <div class="movie-card shadow">

                        <img src="@(string.IsNullOrEmpty(movie.ImageUrl)
                                                     ? "https://via.placeholder.com/300x450"
                                                     : movie.ImageUrl)"
                     class="w-100 movie-img" />

                    <!-- BODY -->
                    <div class="card-body">
                        <h5 class="card-title">@movie.Title</h5>
                        <p class="card-text">@movie.ReleaseYear • @movie.Type</p>
                        <p class="card-text text-muted">@movie.Genre</p>
                    </div>

                    <!-- FOOTER -->
                    <div class="card-footer text-center">
                        <a asp-action="Details" asp-route-id="@movie.Id" class="btn btn-info btn-sm">Details</a>
                        <a asp-action="Edit" asp-route-id="@movie.Id" class="btn btn-primary btn-sm">Edit</a>
                        <a asp-action="Delete" asp-route-id="@movie.Id" class="btn btn-info btn-sm">Details</a>
                    </div>

                </div>
            </div>
        }

    </div>
</div>