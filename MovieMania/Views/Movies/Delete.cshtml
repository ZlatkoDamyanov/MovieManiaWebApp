@using Data
@model Movie

<style>
    .modal-overlay {
        background-color: rgba(0, 0, 0, 0.8);
    }

    .modal-dark {
        background-color: #1a1a1a;
        border: 1px solid #2a2a2a;
        color: white;
    }

    .modal-dark-border {
        border-color: #2a2a2a;
    }

    .movie-thumbnail {
        width: 100px;
        height: 150px;
        object-fit: cover;
        border-radius: 6px;
    }

    .alert-danger-dark {
        background-color: #2a1a1a;
        border: 1px solid #5a2a2a;
        color: #ff8080;
    }
</style>

@{
    var imageUrl = string.IsNullOrEmpty(Model.ImageUrl)
        ? "https://placehold.co/100x150/1a1a1a/555?text=No+Image"
        : Model.ImageUrl;
}

<div class="modal fade show d-block modal-overlay" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content modal-dark">

            <div class="modal-header modal-dark-border">
                <h5 class="modal-title">Изтриване на филм</h5>
            </div>

            <div class="modal-body">
                <div class="d-flex gap-3">
                    <img src="@imageUrl"
                         alt="@Model.Title"
                         class="movie-thumbnail" />
                    <div>
                        <h5 class="mb-1">@Model.Title</h5>
                        <p class="text-muted small mb-1">Режисьор: @Model.Director</p>
                        <p class="text-muted small mb-1">Година: @Model.ReleaseYear</p>
                        <p class="text-muted small mb-0">Жанр: @Model.Genre</p>
                    </div>
                </div>

                <div class="alert alert-danger-dark mt-3 mb-0">
                    Сигурни ли сте, че искате да изтриете този филм? Това действие е необратимо.
                </div>
            </div>

            <div class="modal-footer modal-dark-border">
                <a href="/Movies/Index" class="btn btn-success me-3">
                    Отказ
                </a>
                <form method="post">
                    <button type="submit" class="btn btn-danger me-3">
                        Да, изтрий
                    </button>
                </form>
            </div>

        </div>
    </div>
</div>